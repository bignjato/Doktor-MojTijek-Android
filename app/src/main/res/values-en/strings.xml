    <string name="hc_privatnost_naslov">Health Connect and MojTijek</string>
    <string name="hc_privatnost">MojTijek only reads from Health Connect: steps, heart rate, blood pressure, sleep, oxygen saturation, blood glucose and weight. It writes nothing. The values are stored in the app database on this device, under the family member you choose, and are not sent to a server. You can revoke the permission at any time in Health Connect settings.</string>
